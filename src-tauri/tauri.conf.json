{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cirrus",
  "version": "1.4.7",
  "identifier": "com.cirrus",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Cirrus",
        "width": 1360,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://webapi.amap.com https://*.amap.com 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; media-src 'self' blob: https: http:; connect-src 'self' ipc: http://ipc.localhost https: http:; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installerHooks": "windows/nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCNzFDOEZEODkwMjQ0OTgKUldTWVJBS0ovY2h4YXhUeTE0OFlTMDc2TFdxSkhrZkh4ZVRIYUF2TkowblphNDZOdCtaY1VNL1gK",
      "endpoints": [
        "https://github.com/zhukj125/cirrus/releases/latest/download/latest.json"
      ]
    }
  }
}
