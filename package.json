{
  "name": "cirrus",
  "version": "1.4.2",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Cirrus · Find My devices and iCloud Photos",
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "dev:tauri": "tauri dev",
    "typecheck": "vue-tsc --noEmit --project apps/desktop/tsconfig.json",
    "build": "vite build --config apps/desktop/vite.config.ts",
    "build:checked": "pnpm typecheck && pnpm build",
    "build:mcp": "cargo build -p cirrus-mcp",
    "build:mcp:sidecar": "node scripts/build-mcp-sidecar.mjs",
    "check": "node scripts/run-check.mjs",
    "lint": "oxlint --vue-plugin apps/desktop/src",
    "fmt": "oxfmt \"apps/desktop/src/**/*.{ts,vue}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --config apps/desktop/vite.config.ts",
    "tauri": "tauri",
    "prepare": "husky"
  },
  "dependencies": {
    "@lucide/vue": "1.17.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pinia": "^3.0.0",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "0.53.0",
    "oxlint": "^1.68.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  },
  "lint-staged": {
    "apps/desktop/src/**/*.{ts,vue}": "oxfmt"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.10.0"
}
